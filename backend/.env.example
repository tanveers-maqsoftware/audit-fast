# AuditFAST MCP server configuration.
# Copy to .env and fill in, or set these in the MCP client's env block.

# --- Required -------------------------------------------------------------
# Entra app registration (public client, "Allow public client flows" = Yes).
# Delegated API permissions: Workspace.Read.All, Item.Read.All
AUDITFAST_CLIENT_ID=

# Tenant to sign in against. "organizations" works for most; use the tenant GUID
# to pin sign-in to one directory.
AUDITFAST_TENANT_ID=organizations

# --- Optional -------------------------------------------------------------
# Where engagements, the token cache, and reports are written.
# Defaults to %LOCALAPPDATA%\AuditFAST on Windows.
# AUDITFAST_DATA_DIR=

# Fabric's Get*Definition APIs require the Item.ReadWrite.All delegated scope even
# though the operation only reads. Turn this on to enable the pipeline and notebook
# checks; leave it off to run inventory/security/DevOps checks on read-only scopes
# alone. The guardrail blocks every write verb either way.
AUDITFAST_ENABLE_DEFINITION_READS=false

# Resource limits — these protect the client's Fabric capacity.
AUDITFAST_REQUEST_TIMEOUT_SECONDS=30
AUDITFAST_MAX_CONCURRENT_CALLS=4
AUDITFAST_MAX_ITEMS_INSPECTED=200

# Naming conventions the rules score against (per engagement).
# AUDITFAST_WORKSPACE_NAME_PATTERN=^[A-Za-z0-9]+([ _-][A-Za-z0-9]+)*$
# AUDITFAST_PIPELINE_NAME_PATTERN=^(PL|Pipeline)[_-][A-Za-z0-9_-]+$
# AUDITFAST_NOTEBOOK_NAME_PATTERN=^(NB|Notebook)[_-][A-Za-z0-9_-]+$
